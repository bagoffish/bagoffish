{
  "manifest_version": 3,
  "name": "Omni Archiver (Roblox Focus)",
  "version": "1.0.18",
  "description": "Local-first Roblox archiver (groups/walls/forums/events + layouts) - manual-start wall pager, reload button, proxy fetch, saved cursor state.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Omni Archiver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.roblox.com/*",
        "*://web.roblox.com/*"
      ],
      "js": [
        "roblox/roblox_capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "roblox/roblox_page_hook.js"
      ],
      "matches": [
        "*://www.roblox.com/*",
        "*://web.roblox.com/*",
        "*://*.roblox.com/*"
      ]
    }
  ]
}